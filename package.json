{
  "name": "diablorun-d2r-client",
  "version": "2.0.0",
  "description": "Local Linux web timer for Diablo II: Resurrected with loading-based IGT",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.spec.ts"
  },
  "keywords": [
    "diablo",
    "d2r",
    "speedrun",
    "timer",
    "obs"
  ],
  "author": {
    "name": "Leede OÜ",
    "email": "info@leede.ee"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
